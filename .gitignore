# JARVIS Core - Git Ignore
# Protect sensitive files and unnecessary directories

# ===========================================
# SENSITIVE FILES (NEVER COMMIT)
# ===========================================
.env
.env.local
.env.production
*.key
*.pem
*.p12

# OpenClaw config backups
config/openclaw.json.bak
config/*.bak

# ===========================================
# DEPENDENCIES
# ===========================================
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# ===========================================
# IDE & EDITOR
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===========================================
# LOGS
# ===========================================
*.log
/tmp/
/logs/
npm-debug.log*

# ===========================================
# DOCKER
# ===========================================
# Docker volumes are mounted, not stored in repo
volumes/

# ===========================================
# BUILD OUTPUT
# ===========================================
dist/
build/
*.tgz
*.tar.gz
.next/
.turbo/
next-env.d.ts
tsconfig.tsbuildinfo

# BUT @jarvis/shared/dist must be committed (it's a built artifact that the
# api + hermes Dockerfiles COPY into the runner stage). F0 closure.
!packages/shared/dist/

# ===========================================
# COVERAGE & TESTING
# ===========================================
coverage/
.nyc_output/

# ===========================================
# MISC
# ===========================================
*.cache
.local/

# ===========================================
# TYPE-DRIFT CHECK ARTIFACT
# ===========================================
# Generated by pnpm type-drift:check (the migration-hash file is a
# runtime cache of the supabase migration hash; regenerated on every run).
.migration-hash