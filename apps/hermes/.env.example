# =============================================================================
# Hermes local-dev env (do NOT commit secrets)
# =============================================================================

NODE_ENV=development
PORT=8765
HOST=0.0.0.0

# OpenRouter (required)
OPENROUTER_API_KEY=

# Redis (optional in dev; required for cron E4 and budget tracking)
REDIS_URL=redis://localhost:6379

# Docker control (H1 — only the proxy is allowed; no raw socket in this container)
DOCKER_HOST=tcp://docker-socket-proxy:2375

# Budget gate (USD/day; $0.50 matches Part 1 §1.5)
HERMES_DAILY_BUDGET_USD=0.50

# Where skill docs live (inside the container, the volume mounts here)
SKILLS_DIR=/app/data/skills

# How often the boot-check pings the resolved primary (ms)
BOOT_CHECK_INTERVAL_MS=300000
