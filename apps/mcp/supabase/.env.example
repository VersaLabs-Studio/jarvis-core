# Supabase Personal Access Token (required)
# Generate: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_REPLACE_ME

# Supabase project reference (required)
# Find at: https://supabase.com/dashboard/project/_/settings/general
# Format: 20-character alphanumeric string (e.g. "abcdefghijklmnopqrst")
SUPABASE_PROJECT_REF=REPLACE_ME
