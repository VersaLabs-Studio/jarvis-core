# JARVIS API - Local development .env (gitignored)
# =============================================================================
# Copy to .env (gitignored) and fill in. Used by `pnpm dev` (tsx watch)
# in apps/api/. Local dev: the API runs on http://localhost:3001; Hermes
# (if needed) runs separately via `pnpm --filter @jarvis/hermes dev`.
# CORS_ORIGINS is OPTIONAL in dev (default = allow all).
# =============================================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Supabase (use the hosted project's dev branch, NOT prod)
SUPABASE_URL=https://rofvgnvhmwsgrqewcbci.supabase.co
SUPABASE_JWKS_URL=https://rofvgnvhmwsgrqewcbci.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key for sealing integration secrets. Generate: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=

# CORS (optional in dev; comma-separated origins, or omit for "allow all")
# CORS_ORIGINS=http://localhost:3000
