    "jose": "^6.2.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.0",
