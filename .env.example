# JARVIS Core - Production .env (Phase F — co-tenant VPS, Vercel web)
# =============================================================================
# Copy this file to .env (gitignored), chmod 600, and fill in every value.
# `docker compose` reads this file from the repo root (same dir as the
# compose file). Each app's Dockerfile inherits the env via `environment:`
# directives in docker-compose.yml.
#
# Supabase is HOSTED (project rofvgnvhmwsgrqewcbci). Migration
# 0004_role_grants.sql is already applied+verified on the hosted project
# (2026-06-13); do NOT re-run.
#
# Web deploys to VERCEL (https://jarvis.versalabs-studio.com). The web's
# env (NEXT_PUBLIC_API_URL etc.) is set in the Vercel project, not here.
# =============================================================================

# ---- Runtime ----
NODE_ENV=production

# ---- Supabase (hosted project rofvgnvhmwsgrqewcbci) ----
# Dashboard → Project Settings → API
SUPABASE_URL=https://rofvgnvhmwsgrqewcbci.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard → Project Settings → API → JWT Settings → JWKS URL
SUPABASE_JWKS_URL=https://rofvgnvhmwsgrqewcbci.supabase.co/auth/v1/.well-known/jwks.json

# ---- Auth / crypto ----
# Optional: only if using legacy HS256 (the default is the JWKS path above)
JWT_SECRET=
# AES-256-GCM key for sealing integration secrets (Part 2 §2.6)
MASTER_ENCRYPTION_KEY=

# ---- LLM ----
# OpenRouter — used by Hermes (E0) for all chat + skill completions
OPENROUTER_API_KEY=

# ---- Redis (INTERNAL ONLY on the JARVIS docker network) ----
# Not exposed to host. Used by Hermes (BullMQ cron E4) + API cache.
REDIS_PASSWORD=

# ---- Docker control (via socket-proxy; H1) ----
# Hardcoded in compose (tcp://docker-socket-proxy:2375); not env-driven

# ---- Hermes ↔ API service auth (E4 cron) ----
# Shared secret the API's auth middleware checks on /api/cms/workflow_runs.
# Generate: openssl rand -hex 32
HERMES_SERVICE_TOKEN=

# ---- CORS (REQUIRED in production — fail-loud at api boot if unset) ----
# The Vercel web origin. Comma-separate for multiple origins
# (e.g. preview deployments like https://jarvis-<hash>.vercel.app).
CORS_ORIGINS=https://jarvis.versalabs-studio.com

# ---- Public base URL of THIS API ----
# Used for OAuth redirects, webhook callbacks, mobile EXPO_PUBLIC_API_URL.
PUBLIC_API_URL=https://api.jarvis.versalabs-studio.com

# ---- Optional: hosted project URL for Supabase CLI / pg_dump ----
# (Phase F F5 backup.sh uses this; set when you wire the backup drill)
# DATABASE_URL=postgres://postgres:<password>@db.rofvgnvhmwsgrqewcbci.supabase.co:5432/postgres

# ---- Optional: Telegram (F4) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOW_FROM=

# ---- Optional: observability (F2) ----
# SENTRY_DSN=  (or GLITCHTIP_DSN=)
