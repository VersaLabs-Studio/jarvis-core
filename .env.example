# JARVIS Core Environment Configuration
# Work Package A3: Docker Compose Environment
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ===========================================
# SUPABASE - Database & Auth
# ===========================================
# PostgreSQL password (minimum 32 characters)
POSTGRES_PASSWORD=your_postgres_password_here_minimum_32_chars

# JWT Secret for Supabase (minimum 32 characters)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# Supabase keys (generate after first run)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase URL (internal Docker network)
SUPABASE_URL=http://supabase-kong:8000

# Database connection string
DATABASE_URL=postgres://postgres:your_postgres_password_here@supabase-db:5432/postgres

# Site URL for auth redirects
SITE_URL=http://localhost:3000

# Secret key base for Realtime (minimum 32 characters)
SECRET_KEY_BASE=your_secret_key_base_here_minimum_32_characters_long

# ===========================================
# JARVIS - Application
# ===========================================
# Node environment
NODE_ENV=development

# API configuration
API_PORT=3000
API_HOST=0.0.0.0

# Web configuration
WEB_PORT=3000

# ===========================================
# OPENROUTER - LLM API Access
# ===========================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===========================================
# GITHUB - Repository Management
# ===========================================
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# Required scopes: repo, workflow, read:org

# ===========================================
# VERCEL - Deployment
# ===========================================
VERCEL_TOKEN=your_vercel_token_here

# ===========================================
# NOTION - Documentation & Knowledge Base
# ===========================================
NOTION_API_KEY=your_notion_integration_key_here

# ===========================================
# TELEGRAM - Chat Interface
# ===========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Create bot via @BotFather

# ===========================================
# JARVIS CONFIGURATION
# ===========================================
# Default model for planning/audit
JARVIS_DEFAULT_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# Gateway token (auto-generated on first setup)
GATEWAY_TOKEN=

# Dashboard authentication
DASHBOARD_TOKEN=

# ===========================================
# SECURITY
# ===========================================
# Bind address (127.0.0.1 for local only, 0.0.0.0 for public)
GATEWAY_BIND=0.0.0.0

# Telegram allowlist (your user ID)
TELEGRAM_ALLOW_FROM=

# ===========================================
# MCP SERVERS (Optional)
# ===========================================
# Enable/disable MCP servers
MCP_GITHUB_ENABLED=true
MCP_VERCEL_ENABLED=false
MCP_NOTION_ENABLED=false
MCP_BROWSER_ENABLED=false

# ===========================================
# BACKUP & MONITORING
# ===========================================
# Auto-backup to GitHub (true/false)
AUTO_BACKUP=true

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 8 * * *
